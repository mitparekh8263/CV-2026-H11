        "def otsu_threshold(image):\n",
        "    # 1. Compute the histogram and get pixel counts for each intensity (0-255)\n",
        "    hist, bin_edges = np.histogram(image, bins=256, range=(0, 256))\n",
        "\n",
        "    # 2. Get total number of pixels in the image\n",
        "    total_pixels = image.size\n",
        "\n",
        "    # 3. Create an array of all possible intensity levels [0, 1, 2, ..., 255]\n",
        "    intensities = np.arange(256)\n",
        "\n",
        "    # Initialize variables to keep track of the best threshold\n",
        "    max_variance = -1\n",
        "    best_threshold = 0\n",
        "\n",
        "    # 4. Iterate through all possible thresholds (from 0 to 255)\n",
        "    for i in range(256):\n",
        "        # Background class (pixels <= i)\n",
        "        w0 = np.sum(hist[:i])        # Weight (pixel count)\n",
        "        # Foreground class (pixels > i)\n",
        "        w1 = np.sum(hist[i:])        # Weight (pixel count)\n",
        "\n",
        "        # If either class is empty, this threshold is invalid; skip it\n",
        "        if w0 == 0 or w1 == 0:\n",
        "            continue\n",
        "\n",
        "        # Calculate the mean intensity for Background (m0) and Foreground (m1)\n",
        "        m0 = np.sum(intensities[:i] * hist[:i]) / w0\n",
        "        m1 = np.sum(intensities[i:] * hist[i:]) / w1\n",
        "\n",
        "        # 5. Calculate Between-Class Variance\n",
        "        # Formula: w0 * w1 * (m0 - m1)^2\n",
        "        variance = w0 * w1 * ((m0 - m1) ** 2)\n",
        "\n",
        "        # 6. Check if this variance is the maximum found so far\n",
        "        if variance > max_variance:\n",
        "            max_variance = variance\n",
        "            best_threshold = i\n",
        "\n",
        "    # 7. Apply the optimal threshold to create a binary image\n",
        "    binary_output = (image > best_threshold).astype(np.uint8) * 255\n",
        "\n",
        "    return best_threshold, binary_output"
      ],
